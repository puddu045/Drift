# Copy to .env.local and fill in for local development.

# Same Supabase project the API and mobile app use (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# The NestJS API from /api — same one the mobile app talks to.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Temporary, local-setup-only opt-out — skips the authenticator-app (MFA)
# step and goes straight in once role === 'admin' is confirmed. Remove this
# once MFA is set up for real; must match REQUIRE_ADMIN_MFA in /api's .env.
# NEXT_PUBLIC_REQUIRE_ADMIN_MFA=false
