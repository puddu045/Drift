# Copy to .env and fill in for local development.
# See /ARCHITECTURE.md for how this fits the overall backend design.

PORT=3000

# Local Postgres for development. In staging/production this points at the
# Supabase project's Postgres connection string instead.
DATABASE_URL="postgresql://drift:drift_dev_password@localhost:5432/drift_dev"

# Supabase project settings (Project Settings -> API, and Auth -> JWT Keys).
# SUPABASE_URL is always needed. Use SUPABASE_JWKS_URL for a project on the
# newer asymmetric (JWKS) signing keys, or SUPABASE_JWT_SECRET for a project
# still on the legacy shared HS256 secret — set whichever one applies.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_SECRET=

# Origins allowed to call this API from a browser (comma-separated). Only
# matters for the admin portal — the mobile app isn't a browser, so CORS
# never applies to it. Defaults to the admin portal's local dev URL.
# CORS_ORIGINS="http://localhost:3001"

# Temporary, local-setup-only opt-out — skips the MFA (aal2) requirement on
# admin routes, leaving the role check in place. Remove this once MFA is set
# up for real; must match NEXT_PUBLIC_REQUIRE_ADMIN_MFA in /admin's .env.local.
# REQUIRE_ADMIN_MFA=false

# Google Cloud Translation API key, for translating thoughts/replies/bios
# into each user's preferred language (src/translation). Optional — without
# it, TranslationService is a no-op and content is always shown as written.
# Get one from the Google Cloud Console: enable the "Cloud Translation API"
# on a project, then Credentials -> Create Credentials -> API key.
# GOOGLE_TRANSLATE_API_KEY=

# Hard monthly cap, in characters, on what TranslationService will send to
# Google — stays well under the free tier (500,000/month) by default. Once
# reached, translation requests fall back to showing the original text
# (logged, not an error) until the next calendar month.
# TRANSLATION_MONTHLY_CHAR_LIMIT=450000
