// Drift data model — see /ARCHITECTURE.md §2 for the entity rationale.
//
// Note on auth: Supabase Auth owns sign-up/sign-in and its own `auth.users`
// table. We don't mirror that table here. Instead, `User.id` is always the
// same UUID as the Supabase-verified JWT's `sub` claim, and a User/UserProfile
// row is created lazily the first time we see a valid token for that id (see
// src/users/users.service.ts). This avoids needing a cross-schema Postgres
// trigger and keeps this schema fully portable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
  banned
  deleted
}

enum RelationshipIntent {
  friendship
  romance
  open
  just_sharing
}

enum Mood {
  love
  deep
  happy
  reflective
  hopeful
  random
  lonely
  curious
}

enum ReactionType {
  heart
  relate
  beautiful
  thoughtful
  hug
}

enum ConnectionRequestStatus {
  pending
  accepted
  declined
  withdrawn
}

enum NotificationType {
  reaction
  reply
  connection_request
  connection_accepted
  message
  destiny_ready
}

enum ReportTargetType {
  thought
  reply
  profile
  message
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum ModerationActionType {
  content_removed
  warning
  suspended
  banned
  dismissed
}

model User {
  id        String     @id @db.Uuid
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  profile     UserProfile?
  preferences UserPreferences?
  interests   UserInterest[]

  thoughts  Thought[]
  reactions ThoughtReaction[]
  replies   ThoughtReply[]

  sentConnectionRequests     ConnectionRequest[] @relation("RequestsSent")
  receivedConnectionRequests ConnectionRequest[] @relation("RequestsReceived")
  connectionsAsA             Connection[]        @relation("ConnectionUserA")
  connectionsAsB             Connection[]        @relation("ConnectionUserB")

  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  notifications Notification[]
  deviceTokens  DeviceToken[]

  blocksMade        Block[]            @relation("BlocksMade")
  blocksReceived    Block[]            @relation("BlocksReceived")
  mutesMade         Mute[]             @relation("MutesMade")
  mutesReceived     Mute[]             @relation("MutesReceived")
  reportsMade       Report[]           @relation("ReportsMade")
  moderationActions ModerationAction[] @relation("ModerationActionsTaken")

  destinyAssignments DestinyAssignment[]
  auditLogs          AuditLog[]

  @@map("users")
}

model UserProfile {
  userId             String             @id @db.Uuid
  displayName        String
  username           String             @unique
  photoUrl           String?
  bio                String?
  country             String?
  relationshipIntent RelationshipIntent @default(just_sharing)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreferences {
  userId                    String  @id @db.Uuid
  languages                 String[]
  // The language content is translated into for this user, e.g. "en", "es",
  // "pt-BR". Unset (null) means no translation — thoughts/replies/bios are
  // shown exactly as their author wrote them. Distinct from `languages`
  // above (languages the user understands/speaks, not yet wired to
  // anything) — this one drives TranslationService.
  preferredLanguage         String?
  showCountry               Boolean @default(false)
  showActivity              Boolean @default(false)
  discoverable              Boolean @default(true)
  // Default off — see DECISIONS.md #1 (anonymous by default, user-controlled reveal).
  showIdentityOnContent     Boolean @default(false)
  allowConnectionRequests   Boolean @default(true)
  notifyReactions           Boolean @default(true)
  notifyReplies             Boolean @default(true)
  notifyConnectionRequests  Boolean @default(true)
  notifyConnectionAccepted  Boolean @default(true)
  notifyMessages            Boolean @default(true)
  notifyDestiny             Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Interest {
  id    String         @id @default(uuid()) @db.Uuid
  name  String         @unique
  users UserInterest[]

  @@map("interests")
}

model UserInterest {
  userId     String @db.Uuid
  interestId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model Thought {
  id        String    @id @default(uuid()) @db.Uuid
  authorId  String    @db.Uuid
  text      String    @db.VarChar(280)
  mood      Mood
  isPublic  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author             User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions          ThoughtReaction[]
  replies            ThoughtReply[]
  reports            Report[]            @relation("ReportedThought")
  destinyAssignments DestinyAssignment[]

  @@index([isPublic, createdAt])
  @@index([authorId])
  @@map("thoughts")
}

model ThoughtReaction {
  id        String       @id @default(uuid()) @db.Uuid
  thoughtId String       @db.Uuid
  userId    String       @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now())

  thought Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([thoughtId, userId, type])
  @@index([thoughtId])
  @@map("thought_reactions")
}

model ThoughtReply {
  id        String    @id @default(uuid()) @db.Uuid
  thoughtId String    @db.Uuid
  authorId  String    @db.Uuid
  text      String    @db.VarChar(280)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  thought Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports Report[] @relation("ReportedReply")

  @@index([thoughtId, createdAt])
  @@map("thought_replies")
}

model ConnectionRequest {
  id           String                  @id @default(uuid()) @db.Uuid
  senderId     String                  @db.Uuid
  recipientId  String                  @db.Uuid
  status       ConnectionRequestStatus @default(pending)
  introMessage String?                 @db.VarChar(280)
  createdAt    DateTime                @default(now())
  respondedAt  DateTime?

  sender    User @relation("RequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("RequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([recipientId, status])
  @@map("connection_requests")
}

model Connection {
  id        String    @id @default(uuid()) @db.Uuid
  userAId   String    @db.Uuid
  userBId   String    @db.Uuid
  createdAt DateTime  @default(now())
  removedAt DateTime?

  userA        User          @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userAId, userBId])
  @@map("connections")
}

model Conversation {
  id           String   @id @default(uuid()) @db.Uuid
  connectionId String   @unique @db.Uuid
  createdAt    DateTime @default(now())

  connection   Connection                @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @db.Uuid
  userId         String @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  senderId       String    @db.Uuid
  text           String
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports      Report[]     @relation("ReportedMessage")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

// Unlike Block, muting is silent (the muted user is never told) and one-way:
// it only hides the muted user's thoughts from the muter's feeds. It doesn't
// sever connections or block messaging/connection requests.
model Mute {
  id        String   @id @default(uuid()) @db.Uuid
  muterId   String   @db.Uuid
  mutedId   String   @db.Uuid
  createdAt DateTime @default(now())

  muter User @relation("MutesMade", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@map("mutes")
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @db.Uuid
  targetType     ReportTargetType
  thoughtId      String?          @db.Uuid
  replyId        String?          @db.Uuid
  messageId      String?          @db.Uuid
  reportedUserId String?          @db.Uuid
  reason         String
  status         ReportStatus     @default(open)
  createdAt      DateTime         @default(now())

  reporter          User               @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  thought           Thought?           @relation("ReportedThought", fields: [thoughtId], references: [id], onDelete: SetNull)
  reply             ThoughtReply?      @relation("ReportedReply", fields: [replyId], references: [id], onDelete: SetNull)
  message           Message?           @relation("ReportedMessage", fields: [messageId], references: [id], onDelete: SetNull)
  moderationActions ModerationAction[]

  @@index([status, createdAt])
  @@map("reports")
}

model ModerationAction {
  id        String               @id @default(uuid()) @db.Uuid
  reportId  String?              @db.Uuid
  adminId   String               @db.Uuid
  action    ModerationActionType
  notes     String?
  createdAt DateTime             @default(now())

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  admin  User    @relation("ModerationActionsTaken", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("moderation_actions")
}

model DestinyAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  thoughtId    String   @db.Uuid
  assignedDate DateTime @db.Date
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  thought Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  @@unique([userId, assignedDate])
  @@map("destiny_assignments")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Cache for TranslationService, keyed by a hash of the source text rather
// than content id/type — any identical text in any target language reuses
// the same row, and it stays valid even if the same text is later attached
// to different content. Lets a popular thought's translation be computed
// once no matter how many viewers in that language see it.
model Translation {
  textHash       String  @db.VarChar(64)
  targetLanguage String  @db.VarChar(10)
  sourceText     String
  translatedText String
  // From Google's response — lets a later request for a DIFFERENT target
  // language skip the API call entirely when that target turns out to
  // match the content's own language (checked across all rows for this
  // textHash, not just this one target). Null for rows written before this
  // column existed.
  detectedSourceLanguage String? @db.VarChar(10)
  // Metadata only, not part of the cache key — which thought/reply/profile
  // this translation was first requested for. Never used to decide a cache
  // hit (that's textHash + targetLanguage alone, so identical text in a
  // different piece of content still reuses this row).
  sourceType String?
  sourceId   String?
  createdAt  DateTime @default(now())

  @@id([textHash, targetLanguage])
  @@map("translations")
}

// One row per calendar month (UTC), incremented by the actual character
// count sent to Google on every real API call (not cache hits). Backs the
// configurable monthly hard limit in TranslationService.
model TranslationUsage {
  month          String @id @db.VarChar(7)
  characterCount Int    @default(0)

  @@map("translation_usage")
}

// One row per (user, content, day) the user has translated — lets
// TranslationService cap each user at a fixed number of *distinct* items
// (thoughts, replies, bios — anything with its own translate endpoint)
// translated per day, shared across all of them, without penalizing
// re-toggling something already unlocked today. contentType is one of
// 'thought' | 'reply' | 'profile_bio'. See TranslationService.reserveDailyQuota.
model TranslationQuota {
  id          String   @id @default(uuid())
  userId      String   @db.Uuid
  contentType String   @db.VarChar(20)
  contentId   String
  day         String   @db.VarChar(10)
  createdAt   DateTime @default(now())

  @@unique([userId, contentType, contentId, day])
  @@index([userId, day])
  @@map("translation_quota")
}
